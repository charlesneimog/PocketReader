ALLOWED_ORIGINS=https://charlesneimog.github.io,http://localhost:8080,http://127.0.0.1:8080
# Set true to reflect any Origin in CORS responses (use with care in production).
ALLOW_ANY_ORIGIN=false
TRANSLATE_TARGET_LANG=pt
AUTH_SECRET=change-me-long-random
AUTH_TOKEN_TTL_SECONDS=604800

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=myserver@gmail.com
SMTP_PASS=mypassword
SMTP_FROM=myserver@gmail.com

APP_NAME=PocketReader
PUBLIC_APP_URL=mypublicdomain.com

# Reading summary emails use the same SMTP account as password recovery.
READING_DIGEST_ENABLED=true
READING_DIGEST_POLL_SECONDS=900
# Hours are evaluated in each user's browser-reported IANA timezone.
READING_DIGEST_WEEKLY_HOUR=18
READING_DIGEST_MONTHLY_HOUR=9
READING_DIGEST_YEARLY_HOUR=18

# Daily reading reminders are opt-in per account in Settings.
READING_REMINDER_ENABLED=true
READING_REMINDER_POLL_SECONDS=60
